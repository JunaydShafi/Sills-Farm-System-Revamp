
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations.
/// Visit https://pris.ly/d/check-constraints for more info.
model users {
  id            Int             @id @default(autoincrement())
  employee_id   Int?
  name          String          @db.VarChar(150)
  username      String          @unique @db.VarChar(50)
  password_hash String
  role          String          @default("Employee") @db.VarChar(20)
  status        String          @default("Active") @db.VarChar(20)
  last_login    DateTime?       @db.Timestamptz(6)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  user_sessions user_sessions[]
}

model user_sessions {
  id         String    @id @db.Uuid
  user_id    Int
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_sessions_user_fk")

  @@index([expires_at], map: "idx_user_sessions_expires_at")
  @@index([user_id], map: "idx_user_sessions_user_id")
}

// Tracks temporary login restrictions by username.
// No passwords or password hashes are stored here.
model login_attempts {
  username       String    @id @db.VarChar(50)
  failed_count   Int       @default(0)
  window_start   DateTime  @default(now()) @db.Timestamptz(6)
  locked_until   DateTime? @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)

  @@index([locked_until])
}
// Stores customer information for the Sills Farm Business Management System.
 // Customer codes are unique to prevent duplicate customer records.
 model customers {
   id            Int      @id @default(autoincrement())
   customer_code String   @unique @db.VarChar(30)
   name          String   @db.VarChar(150)
   address       String   @db.VarChar(255)
   city          String   @db.VarChar(100)
   state         String   @db.VarChar(2)
   zip           String   @db.VarChar(10)
   phone         String   @db.VarChar(25)
   status        String   @default("Active") @db.VarChar(20)
   created_at    DateTime @default(now()) @db.Timestamptz(6)
 }

// A processing run. process_number is the "Proc" shown on inventory screens.
model processes {
  id                   Int                    @id @default(autoincrement())
  process_number       Int                    @unique
  description          String                 @db.VarChar(150)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  bag_inventory_items  bag_inventory_items[]
}

// A product that can be sold. item_code is the "SaleItemID" on Bag Inventory.
model sale_items {
  id                   Int                    @id @default(autoincrement())
  item_code            String                 @unique @db.VarChar(30)
  name                 String                 @db.VarChar(150)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  bag_inventory_items  bag_inventory_items[]
}

// One row of Bag Inventory: a sale item bagged from a process at a bag size.
// Balances are calculated from the tables below and are never stored here.
model bag_inventory_items {
  id                Int               @id @default(autoincrement())
  process_id        Int
  sale_item_id      Int
  factor_lbs        Int
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  processes         processes         @relation(fields: [process_id], references: [id], onUpdate: NoAction)
  sale_items        sale_items        @relation(fields: [sale_item_id], references: [id], onUpdate: NoAction)
  bagging_records   bagging_records[]
  bag_sales         bag_sales[]

  @@unique([process_id, sale_item_id, factor_lbs])
}

// Bags produced. Only "Completed" records count toward Bags Made.
model bagging_records {
  id                  Int                  @id @default(autoincrement())
  inventory_item_id   Int
  bag_date            DateTime             @db.Date
  quantity            Int
  is_adjustment       Boolean              @default(false)
  status              String               @default("Completed") @db.VarChar(20)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  bag_inventory_items bag_inventory_items  @relation(fields: [inventory_item_id], references: [id], onUpdate: NoAction)

  @@index([inventory_item_id])
}

// Bags sold. Orders and invoices can point at this table once they are built.
model bag_sales {
  id                  Int                  @id @default(autoincrement())
  inventory_item_id   Int
  sale_date           DateTime             @db.Date
  units_sold          Int
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  bag_inventory_items bag_inventory_items  @relation(fields: [inventory_item_id], references: [id], onUpdate: NoAction)

  @@index([inventory_item_id])
}